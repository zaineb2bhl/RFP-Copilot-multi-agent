# RFP Copilot configuration. Copy to `.env` and pick ONE profile below.
# Everything is configured through these env vars; no code change is needed to switch.
#
# Data policy: the Gemini free tier may use prompts to improve Google models.
# Only use PUBLIC RFPs and synthetic knowledge-base data with it.

# ---------------------------------------------------------------------------
# Profile 1 - gemini (default for real runs and evals, free tier from AI Studio)
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
# Stronger but much slower on the free tier (~40 s/call when measured): gemini-3.8-flash.
# List the models your key can use: GET https://generativelanguage.googleapis.com/v1beta/openai/models
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Free tier is rate-limited per minute; keep this at or below your quota.
LLM_MAX_RPM=10

# ---------------------------------------------------------------------------
# Profile 2 - ollama (dev, offline, fallback). Requires `ollama pull qwen2.5:3b`.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_MAX_RPM=0
# CPU inference is slow (~6 output tokens/s on an 8 GB laptop): allow long calls, smaller batches.
# LLM_TIMEOUT_S=600
# LLM_MAX_RETRIES=1
# EXTRACTION_BATCH_CHARS=3000
# Ollama endpoint for LLM and embeddings (docker-compose sets the host.docker.internal URL):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Profile 3 - openai (optional, paid)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# LLM_MAX_RPM=0

# ---------------------------------------------------------------------------
# Optional: a different model for the reviewer (LLM-as-judge).
# Unset values fall back to the LLM_* values above (API key only if same provider).
# Example: writer = local Ollama, reviewer = Gemini.
# ---------------------------------------------------------------------------
# REVIEWER_LLM_PROVIDER=gemini
# REVIEWER_LLM_MODEL=gemini-3.5-flash-lite
# REVIEWER_LLM_API_KEY=your-gemini-api-key
# REVIEWER_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Optional: evaluation judge for the eval/ scripts only (falls back to the reviewer).
# A strong judge matters: gemini-3.5-flash-lite rated every claim as supported in our runs.
# gemini-3.8-flash is stricter but slow (~40 s/call) with ~20 free requests per day, so
# do NOT set it as REVIEWER_LLM_MODEL (that would slow down every pipeline run).
# ---------------------------------------------------------------------------
# EVAL_JUDGE_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Embeddings (default: local Ollama nomic-embed-text, `ollama pull nomic-embed-text`)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_API_KEY=your-gemini-api-key   (defaults to LLM_API_KEY when providers match)

# ---------------------------------------------------------------------------
# Free-tier protection
# ---------------------------------------------------------------------------
# LLM_CACHE_ENABLED=true
# LLM_CACHE_PATH=.cache/llm_cache.sqlite
# LLM_MAX_RETRIES=5
# LLM_BACKOFF_BASE_S=2.0
# LLM_BACKOFF_MAX_S=60
# LLM_TIMEOUT_S=120
# Structured output: auto | json_schema | json_object | prompt
# LLM_STRUCTURED_MODE=auto

# ---------------------------------------------------------------------------
# Pipeline tuning (defaults shown)
# ---------------------------------------------------------------------------
# REVIEW_THRESHOLD=0.75        # min (coverage + groundedness) / 2 per section
# MAX_ITERATIONS=2             # write passes, including the first
# RETRIEVAL_K=6                       # passage budget per section, spread over requirements
# RETRIEVAL_MIN_PER_REQUIREMENT=2     # every requirement gets at least this many passages
# RETRIEVAL_MAX_PER_SECTION=10
# MIN_RELEVANCE=0.67                  # relevance floor (cosine); model-specific, recalibrate
#                                     # with `python eval/calibrate_relevance.py`
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# RERANK_ENABLED=false                # listwise LLM reranking (extra calls)

# ---------------------------------------------------------------------------
# Optional observability (Langfuse cloud free tier). Leave empty to disable.
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
